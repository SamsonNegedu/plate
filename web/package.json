{
  "name": "plate-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "test": "vitest run",
    "test:visual": "VISUAL=1 playwright test e2e/visual.spec.ts",
    "lint": "oxlint && oxfmt --check",
    "fmt": "oxfmt",
    "gen:api": "openapi-typescript ../internal/httpapi/openapi.json -o src/api/schema.d.ts",
    "prebuild": "node scripts/copy-wasm.mjs",
    "predev": "node scripts/copy-wasm.mjs",
    "pretest": "node scripts/copy-wasm.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.6",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "barcode-detector": "^3.2.3",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.72.0",
    "minisearch": "^7.2.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-router": "^7.18.5",
    "zod": "^4.6.7",
    "zustand": "^5.1.0",
    "zxing-wasm": "^3.1.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.0",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "packageManager": "pnpm@10.32.1"
}
