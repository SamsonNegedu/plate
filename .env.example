# Copy to .env. `make dev` and `docker compose` both read it. Never commit it.

# --- Required for the first deploy ---
# Public URL. Must be https except on localhost. Change this for production.
PLATE_BASE_URL=http://localhost:8080
# First-boot admin. Ignored once the user exists; remove when convenient.
PLATE_ADMIN_EMAIL=
PLATE_ADMIN_PASSWORD=

# --- Recommended before public use ---
# A real contact so Open Food Facts can identify this client.
PLATE_OFF_USER_AGENT=Plate/1.0 (self-hosted)

# --- Optional: every line below has a working default ---
PLATE_ADDR=:8080
PLATE_DATA_DIR=./data
PLATE_LOG_LEVEL=info

# Password reset: set both, restart, then remove both.
PLATE_ADMIN_RESET_PASSWORD=false

PLATE_SYNC_ENABLED=true
PLATE_INTEGRITY_CHECK=true
PLATE_MAINTENANCE_HOUR=3
PLATE_IMAGE_CACHE_MB=256
PLATE_IMAGE_MAX_BYTES=2000000

PLATE_OFF_BASE_URL=https://world.openfoodfacts.org
PLATE_OFF_SEARCH_URL=https://search.openfoodfacts.org
